{
  "testEnvironment": "node",
  "transform": {},
  "testMatch": ["**/tests/**/*.test.js", "**/__tests__/**/*.test.js"],
  "testTimeout": 30000,
  "collectCoverageFrom": [
    "**/*.js",
    "!**/node_modules/**",
    "!**/tests/**",
    "!**/coverage/**"
  ],
  "silent": false,
  "verbose": true
}
