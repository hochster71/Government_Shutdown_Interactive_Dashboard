# API Keys Configuration
# Copy this file to .env and add your API keys

# NewsAPI Key - Get yours at https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# Server Configuration
PORT=3001
NODE_ENV=development

# Logging Configuration
# LOG_LEVEL can be: debug, info, warn, error
LOG_LEVEL=debug

# CORS Settings
# Comma-separated list of allowed origins
# In development, defaults to http://localhost:5173,http://localhost:5174
# In production, must be explicitly set to the allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Cache Configuration
# TTL for shutdown data cache in seconds (default: 3600 = 1 hour)
SHUTDOWNS_CACHE_TTL_SECONDS=3600
